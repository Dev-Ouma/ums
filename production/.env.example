# Copy into a secret manager or local ignored .env file. Never commit real values.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=ums.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://ums.example.edu

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=ums
DJANGO_DB_USER=ums_app
DJANGO_DB_PASSWORD=replace-with-database-secret
DJANGO_DB_HOST=private-postgres-host
DJANGO_DB_PORT=5432
DJANGO_DB_SSL_REQUIRE=true
DJANGO_DB_SSL_MODE=verify-full
DJANGO_DB_PRIVATE_NETWORK=true

DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
DJANGO_CACHE_LOCATION=redis://private-redis-host:6379/1

DJANGO_HSTS_SECONDS=31536000
UMS_PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
