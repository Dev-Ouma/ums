# Copy into the deployment secret store; do not commit a populated .env file.
DJANGO_SECRET_KEY=replace-with-a-random-production-secret-at-least-50-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=ums.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://ums.example.edu
DJANGO_HSTS_SECONDS=31536000
DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
DJANGO_CACHE_LOCATION=redis://:replace-with-a-secret@127.0.0.1:6379/1
DJANGO_DATA_UPLOAD_MAX_BYTES=10485760
DJANGO_FILE_UPLOAD_MAX_MEMORY_BYTES=5242880

# Configure these through the deployment secret manager as required.
# DATABASE_URL=
# AFRICASTALKING_API_KEY=
# SMTP_PASSWORD=
# MPESA_CONSUMER_SECRET=
